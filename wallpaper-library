#!/bin/bash
# Helper for the io.github.jacueblol.wallpaper-library plugin.
#
#   wallpaper-library list                 JSON: {library, exists, current, categories: [{id, label, count, cover}]}
#   wallpaper-library pick <category>      open the image picker on a category, set the pick as background
#   wallpaper-library random [category]    set a random wallpaper (from one category or the whole library)
#   wallpaper-library download             interactively download categories of dharmx/walls
#   wallpaper-library install-menu         add/refresh Style > Wallpaper Library rows in the Omarchy menu
#   wallpaper-library uninstall-menu       remove those rows again
#
# The library is a folder with one subfolder per category. It comes from
# $WALLPAPER_LIBRARY_DIR, then the widget's libraryDir setting in
# ~/.config/omarchy/shell.json, then ~/.config/omarchy/wallpapers/dharmx-walls.
#
# Categories are opened one at a time on purpose: omarchy-menu-images hands
# the picker every row in one IPC argument, which Linux caps at 128KB
# (MAX_ARG_STRLEN). A whole large library base64-encodes past that.

set -o pipefail

plugin_id="io.github.jacueblol.wallpaper-library"
self=$(readlink -f "${BASH_SOURCE[0]}")
default_library="$HOME/.config/omarchy/wallpapers/dharmx-walls"
walls_repo="https://github.com/dharmx/walls"
shell_json="$HOME/.config/omarchy/shell.json"
menu_file="$HOME/.config/omarchy/extensions/omarchy-menu.jsonc"
begin_marker="  // >>> $plugin_id (generated by: wallpaper-library install-menu)"
end_marker="  // <<< $plugin_id"
image_exts=(-iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.gif' -o -iname '*.bmp' -o -iname '*.webp')

resolve_library() {
  local dir=${WALLPAPER_LIBRARY_DIR:-}
  if [[ -z $dir && -f $shell_json ]]; then
    dir=$(jq -r --arg id "$plugin_id" \
      '[.bar.layout[]?[]? | objects | select(.id == $id) | .libraryDir // empty][0] // empty' \
      "$shell_json" 2>/dev/null)
  fi
  dir=${dir:-$default_library}
  dir=${dir/#\~/$HOME}
  printf '%s' "${dir%/}"
}

library=$(resolve_library)
cover_dir=${XDG_CACHE_HOME:-$HOME/.cache}/omarchy/wallpaper-library/$(printf '%s' "$library" | md5sum | cut -c1-12)

notify() {
  notify-send -a "Wallpaper Library" -i preferences-desktop-wallpaper "$@" 2>/dev/null || printf '%s\n' "$*" >&2
}

images_in() {
  find -L "$1" -maxdepth 1 -type f \( "${image_exts[@]}" \) "${@:2}" 2>/dev/null
}

categories() {
  local dir
  for dir in "$library"/*/; do
    dir=${dir%/}
    [[ ${dir##*/} == .* ]] && continue
    [[ -n $(images_in "$dir" -print -quit) ]] && printf '%s\n' "${dir##*/}"
  done
}

label_for() {
  local name=${1//[-_]/ }
  printf '%s' "${name^}"
}

category_dir() {
  local dir="$library/$1"
  if [[ -z $1 || $1 == */* || $1 == .* || ! -d $dir ]]; then
    notify "Unknown category" "$1"
    return 1
  fi
  printf '%s' "$dir"
}

first_image() {
  images_in "$1" -print0 | sort -z | head -zn 1 | tr -d '\0'
}

# One 16:9 cover per category, from its first image. Missing or stale covers
# are built in parallel, one single-threaded vips run each.
build_covers() {
  local name source cover
  mkdir -p "$cover_dir"
  while IFS= read -r name; do
    source=$(first_image "$library/$name")
    cover="$cover_dir/$name.jpg"
    [[ -n $source && ( ! -f $cover || $source -nt $cover ) ]] && printf '%s\0%s\0' "$source" "$cover"
  done < <(categories) | xargs -0 -r -n 2 -P "$(nproc)" bash -c \
    'VIPS_CONCURRENCY=1 vipsthumbnail "$1" --size 480x270 --smartcrop=attention -o "$2.tmp.jpg[Q=85,strip]" && mv -f "$2.tmp.jpg" "$2"' _ \
    >/dev/null 2>&1
}

list() {
  local name current category=""
  current=$(readlink -f "$HOME/.local/state/omarchy/current/background" 2>/dev/null)

  if [[ ! -d $library ]]; then
    jq -nc --arg library "$library" --arg path "$current" \
      '{library: $library, exists: false, current: {path: $path, category: "", name: ""}, categories: []}'
    return
  fi

  build_covers
  [[ $current == "$(readlink -f "$library")"/*/* ]] && category=$(basename "$(dirname "$current")")

  categories | while IFS= read -r name; do
    jq -nc --arg id "$name" --arg label "$(label_for "$name")" \
      --argjson count "$(images_in "$library/$name" -printf '.' | wc -c)" \
      --arg cover "$cover_dir/$name.jpg" \
      '{id: $id, label: $label, count: $count, cover: $cover}'
  done | jq -sc --arg library "$library" --arg path "$current" --arg category "$category" '{
    library: $library,
    exists: true,
    current: {path: $path, category: $category, name: ($path | split("/") | last // "" | sub("\\.[^.]*$"; ""))},
    categories: .
  }'
}

pick() {
  local dir background
  dir=$(category_dir "$1") || return 1
  if ! background=$(omarchy-menu-images --filterable \
      --selected "$(readlink -f "$HOME/.local/state/omarchy/current/background" 2>/dev/null)" "$dir"); then
    notify "Couldn't open $(label_for "$1")" \
      "The image picker rejected the request. Very large folders (roughly 500+ images) exceed its size limit; split it into smaller categories."
    return 1
  fi
  [[ -n $background ]] && omarchy-theme-bg-set "$background"
}

random() {
  local dir background
  if [[ -n $1 ]]; then
    dir=$(category_dir "$1") || return 1
    background=$(images_in "$dir" | shuf -n 1)
  else
    background=$(find -L "$library" -mindepth 2 -maxdepth 2 -type f \( "${image_exts[@]}" \) -not -path '*/.*' 2>/dev/null | shuf -n 1)
  fi
  if [[ -z $background ]]; then
    notify "No wallpapers found" "$library"
    return 1
  fi
  omarchy-theme-bg-set "$background"
}

# Sparse-clone dharmx/walls so people only download the categories they want
# (the whole collection is several GB). Rerun to add or remove categories.
download() {
  local chosen available
  echo "Wallpaper Library: download from $walls_repo"
  echo "Into: $library"
  echo

  if [[ -d $library && ! -d $library/.git ]]; then
    echo "$library already exists and isn't a dharmx/walls checkout; leaving it alone."
    echo "Point the widget's libraryDir setting at an empty or new folder to download there."
    return 1
  fi

  if [[ ! -d $library/.git ]]; then
    mkdir -p "$(dirname "$library")"
    git clone --depth 1 --filter=blob:none --sparse "$walls_repo" "$library" || return 1
  fi

  available=$(git -C "$library" ls-tree -d --name-only HEAD | grep -v '^\.')
  chosen=$(gum choose --no-limit --height 20 \
    --header "Pick categories (space to select, enter to confirm). The full set is several GB." \
    --selected "$(git -C "$library" sparse-checkout list 2>/dev/null | sed 's|^/||; s|/$||' | paste -sd, -)" \
    $available) || return 1
  [[ -n $chosen ]] || { echo "Nothing selected."; return 0; }

  echo "Downloading: $(paste -sd' ' <<<"$chosen")"
  # shellcheck disable=SC2086
  git -C "$library" sparse-checkout set --no-cone $(sed 's|.*|/&/|' <<<"$chosen") || return 1
  echo
  echo "Done. Open the Wallpaper Library from the bar to browse."
}

strip_menu() {
  # Values go through ENVIRON, not awk -v, which would interpret backslashes.
  BEGIN_MARKER=$begin_marker END_MARKER=$end_marker awk '
    $0 == ENVIRON["BEGIN_MARKER"] { skip = 1; next }
    $0 == ENVIRON["END_MARKER"] { skip = 0; next }
    !skip { print }
  ' "$menu_file"
}

menu_row() {
  # $1 id suffix, $2 icon, $3 label, $4 action
  jq -nc --arg id "style.wallpaper-library$1" --arg icon "$2" --arg label "$3" --arg action "$4" \
    '{($id): {icon: $icon, label: $label, action: $action}}' | sed 's/^{//; s/}$/,/; s/^/  /'
}

install_menu() {
  local stripped block name
  if [[ ! -f $menu_file ]]; then
    echo "Missing $menu_file" >&2
    return 1
  fi
  stripped=$(strip_menu) || return 1

  block="$begin_marker"$'\n'
  block+='  "style.wallpaper-library": {"icon":"","label":"Wallpaper Library","aliases":["wallpapers","walls","library"]},'$'\n'
  block+=$(menu_row ".random" "" "Random" "$(printf '%q random' "$self")")$'\n'
  while IFS= read -r name; do
    block+=$(menu_row ".$(tr -c 'A-Za-z0-9\n-' '-' <<<"$name")" "" "$(label_for "$name")" \
      "$(printf '%q pick %q' "$self" "$name")")$'\n'
  done < <(categories)
  block+="$end_marker"

  cp "$menu_file" "$menu_file.bak.$(date +%s)"
  # Insert before the final closing brace of the JSONC object.
  printf '%s\n' "$stripped" | BLOCK=$block awk '
    { lines[NR] = $0 }
    END {
      for (last = NR; last > 0 && lines[last] !~ /^}/; last--) ;
      for (i = 1; i < last; i++) print lines[i]
      print ENVIRON["BLOCK"]
      for (i = last; i <= NR; i++) print lines[i]
    }
  ' >"$menu_file.tmp" && mv "$menu_file.tmp" "$menu_file"
  echo "Added $(categories | wc -l) categories to Style > Wallpaper Library (backup saved next to $menu_file)"
}

uninstall_menu() {
  [[ -f $menu_file ]] && grep -qF "$begin_marker" "$menu_file" || return 0
  cp "$menu_file" "$menu_file.bak.$(date +%s)"
  strip_menu >"$menu_file.tmp" && mv "$menu_file.tmp" "$menu_file"
  echo "Removed Style > Wallpaper Library rows"
}

case "$1" in
  list) list ;;
  pick) pick "$2" ;;
  random) random "$2" ;;
  download) download ;;
  install-menu) install_menu ;;
  uninstall-menu) uninstall_menu ;;
  *) sed -n '4,10p' "$self" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
